{
  "expo": {
    "name": "Archer Pro",
    "slug": "archer-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#090D10"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zoomy.archerpro"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090D10"
      },
      "package": "com.zoomy.archerpro"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "16d409fc-6840-419b-ae3a-78035c98cacb"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
